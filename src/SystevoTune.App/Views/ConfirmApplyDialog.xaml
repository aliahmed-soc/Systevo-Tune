<Window x:Class="SystevoTune.App.Views.ConfirmApplyDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding [Confirm_Title], Source={StaticResource Loc}}"
        Width="560" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource Background}">

    <StackPanel Margin="22">
        <TextBlock Text="{Binding [Confirm_Title], Source={StaticResource Loc}}" Style="{StaticResource Heading}" />

        <TextBlock Style="{StaticResource MutedText}" Margin="0,0,0,12"
                   Text="{Binding ChangeCount}" />

        <TextBlock Style="{StaticResource MutedText}"
                   Text="{Binding [Confirm_Checking], Source={StaticResource Loc}}"
                   Visibility="{Binding IsChecking, Converter={StaticResource BoolToVisibility}}" />

        <!-- The restore point line, shown when one was made -->
        <StackPanel Visibility="{Binding RestorePointCreated, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{Binding [Confirm_RestorePoint], Source={StaticResource Loc}}" />
            <TextBlock Text="{Binding RestorePointDescription}" FontWeight="SemiBold" Margin="0,4,0,0" />
        </StackPanel>

        <!--
            A6: anything other than "a restore point was created" is a red warning the user has to
            read past. It never blocks — doc 5.1 says warn and ask — but it is never hidden.
        -->
        <Border Style="{StaticResource Card}" Margin="0,12,0,0"
                BorderBrush="{StaticResource Danger}"
                Visibility="{Binding HasWarning, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <TextBlock Style="{StaticResource DangerText}"
                           Text="{Binding [Confirm_RestoreWarningHeader], Source={StaticResource Loc}}" />
                <TextBlock x:Name="WarningText" Style="{StaticResource DangerText}" Margin="0,6,0,0" />
                <TextBlock Text="{Binding EngineMessage}" Style="{StaticResource MutedText}" Margin="0,6,0,0"
                           Visibility="{Binding EngineMessage, Converter={StaticResource StringToVisibility}}" />
            </StackPanel>
        </Border>

        <StackPanel Orientation="Horizontal" Margin="0,18,0,0" HorizontalAlignment="Right">
            <Button Content="{Binding [Common_Cancel], Source={StaticResource Loc}}"
                    IsCancel="True" TabIndex="2"
                    AutomationProperties.Name="{Binding [Common_Cancel], Source={StaticResource Loc}}" />
            <Button Style="{StaticResource PrimaryButton}"
                    Content="{Binding [Confirm_Proceed], Source={StaticResource Loc}}"
                    Click="OnConfirmClick"
                    IsDefault="True" TabIndex="1"
                    AutomationProperties.Name="{Binding [Confirm_Proceed], Source={StaticResource Loc}}" />
        </StackPanel>
    </StackPanel>
</Window>
