<UserControl x:Class="SystevoTune.App.Views.LogsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="{Binding [Logs_Title], Source={StaticResource Loc}}" Style="{StaticResource Heading}" />
            <TextBlock Text="{Binding [Logs_Subtitle], Source={StaticResource Loc}}" Style="{StaticResource Subheading}" />

            <TextBlock Text="{Binding [Logs_Folder], Source={StaticResource Loc}}" Style="{StaticResource MutedText}" />
            <TextBlock Text="{Binding LogFolder}" Style="{StaticResource MutedText}" Margin="0,0,0,8" />

            <TextBlock Style="{StaticResource DangerText}" Text="{Binding Error}"
                       Visibility="{Binding Error, Converter={StaticResource StringToVisibility}}" />

            <TextBlock Style="{StaticResource MutedText}"
                       Text="{Binding [Logs_NoRuns], Source={StaticResource Loc}}"
                       Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />

            <Button Content="{Binding [Common_Refresh], Source={StaticResource Loc}}"
                    Command="{Binding RefreshCommand}" HorizontalAlignment="Left" Margin="0,4,0,10"
                    AutomationProperties.Name="{Binding [Common_Refresh], Source={StaticResource Loc}}"
                    TabIndex="60" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Runs}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="{Binding RunId}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Summary}" Style="{StaticResource MutedText}" />
                                <TextBlock Text="{Binding ProfileId}" Style="{StaticResource MutedText}"
                                           Visibility="{Binding ProfileId, Converter={StaticResource StringToVisibility}}" />
                                <TextBlock Style="{StaticResource DangerText}" Margin="0,4,0,0"
                                           Text="{Binding TornLinesWarning}"
                                           Visibility="{Binding HasTornLines, Converter={StaticResource BoolToVisibility}}" />

                                <ItemsControl ItemsSource="{Binding Records}" Margin="0,8,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,4">
                                                <TextBlock Text="{Binding Target}" />
                                                <TextBlock Style="{StaticResource MutedText}" Margin="12,2,0,0"
                                                           Text="{Binding OldValue}" />
                                                <TextBlock Style="{StaticResource MutedText}" Margin="12,0,0,0"
                                                           Text="{Binding NewValue}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
