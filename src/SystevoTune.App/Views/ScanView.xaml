<UserControl x:Class="SystevoTune.App.Views.ScanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="{Binding [Scan_Title], Source={StaticResource Loc}}" Style="{StaticResource Heading}" />
            <TextBlock Text="{Binding [Scan_Subtitle], Source={StaticResource Loc}}" Style="{StaticResource Subheading}" />

            <TextBlock Style="{StaticResource DangerText}"
                       Text="{Binding Error}"
                       Visibility="{Binding Error, Converter={StaticResource StringToVisibility}}" />

            <TextBlock Style="{StaticResource MutedText}"
                       Text="{Binding [Common_Loading], Source={StaticResource Loc}}"
                       Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

            <!-- C4. Before-values. Hidden entirely when Windows would not answer. -->
            <StackPanel Visibility="{Binding HasMetrics, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding [Scan_MetricsHeader], Source={StaticResource Loc}}"
                           Style="{StaticResource SectionHeading}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="{Binding [Scan_MemoryUsed], Source={StaticResource Loc}}" />
                            <TextBlock Grid.Column="1" Text="{Binding MemoryUsedDisplay}" FontWeight="SemiBold" />
                        </Grid>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="{Binding [Scan_StartupApps], Source={StaticResource Loc}}" />
                            <TextBlock Grid.Column="1" Text="{Binding StartupAppsDisplay}" FontWeight="SemiBold" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Cleanup -->
            <TextBlock Text="{Binding [Scan_CleanupHeader], Source={StaticResource Loc}}"
                       Style="{StaticResource SectionHeading}" />

            <TextBlock Style="{StaticResource MutedText}"
                       Text="{Binding [Scan_NothingToClean], Source={StaticResource Loc}}"
                       Visibility="{Binding NothingToClean, Converter={StaticResource BoolToVisibility}}" />

            <ItemsControl ItemsSource="{Binding CleanupGroups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Name}" />
                                <TextBlock Grid.Column="1" Text="{Binding HumanSize}" FontWeight="SemiBold" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding [Scan_TotalFreeable], Source={StaticResource Loc}}"
                           FontWeight="SemiBold" />
                <TextBlock Grid.Column="1" Text="{Binding TotalFreeable}" FontWeight="SemiBold" />
            </Grid>

            <!-- Settings -->
            <TextBlock Text="{Binding [Scan_TweaksHeader], Source={StaticResource Loc}}"
                       Style="{StaticResource SectionHeading}" />

            <TextBlock Style="{StaticResource MutedText}"
                       Text="{Binding [Scan_NothingToChange], Source={StaticResource Loc}}"
                       Visibility="{Binding NothingToChange, Converter={StaticResource BoolToVisibility}}" />

            <ItemsControl ItemsSource="{Binding Tweaks}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Style="{StaticResource MutedText}" />
                                </Grid>
                                <TextBlock Text="{Binding Detail}" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Style="{StaticResource MutedText}"
                       Text="{Binding [Scan_Empty], Source={StaticResource Loc}}"
                       Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />

            <Button Content="{Binding [Scan_Run], Source={StaticResource Loc}}"
                    Command="{Binding ScanCommand}"
                    HorizontalAlignment="Left" Margin="0,14,0,0"
                    AutomationProperties.Name="{Binding [Scan_Run], Source={StaticResource Loc}}"
                    TabIndex="10" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
