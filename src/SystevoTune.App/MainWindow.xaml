<Window x:Class="SystevoTune.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:SystevoTune.App.Views"
        Title="{Binding Localizer[App_Title]}"
        Icon="Assets/systevo.ico"
        Width="1000" Height="720" MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        FlowDirection="{Binding Localizer.FlowDirection}"
        Background="{StaticResource Background}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header: title, tagline, language switch -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <!--
                    Systevo's own mark, embedded rather than fetched — the app is offline by
                    design. FlowDirection is pinned LeftToRight so the logo is not mirrored when
                    the window flips to Arabic; a logo is artwork, not text.
                -->
                <Image Source="Assets/systevo-logo.png"
                       Width="48" Height="48"
                       Margin="0,0,14,0"
                       VerticalAlignment="Top"
                       FlowDirection="LeftToRight"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       AutomationProperties.Name="{Binding Localizer[App_Brand]}" />

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Localizer[App_Title]}" Style="{StaticResource Heading}" />
                    <TextBlock Text="{Binding Localizer[App_Tagline]}" Style="{StaticResource MutedText}" />
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <TextBlock Text="{Binding Localizer[Common_Language]}"
                           VerticalAlignment="Center" Margin="0,0,8,0"
                           Style="{StaticResource MutedText}" />
                <Button Content="{Binding OtherLanguage.NativeName}"
                        Command="{Binding ToggleLanguageCommand}"
                        MinWidth="120"
                        FlowDirection="LeftToRight"
                        AutomationProperties.Name="{Binding Localizer[Common_Language]}"
                        TabIndex="90" />
            </StackPanel>
        </Grid>

        <!-- Navigation -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,14">
            <Button Content="{Binding Localizer[Nav_Scan]}" Command="{Binding GoToScanCommand}"
                    AutomationProperties.Name="{Binding Localizer[Nav_Scan]}" TabIndex="1" />
            <Button Content="{Binding Localizer[Nav_Review]}" Command="{Binding GoToReviewCommand}"
                    AutomationProperties.Name="{Binding Localizer[Nav_Review]}" TabIndex="2" />
            <Button Content="{Binding Localizer[Nav_Results]}" Command="{Binding GoToResultsCommand}"
                    AutomationProperties.Name="{Binding Localizer[Nav_Results]}" TabIndex="3" />
            <Button Content="{Binding Localizer[Nav_Logs]}" Command="{Binding GoToLogsCommand}"
                    AutomationProperties.Name="{Binding Localizer[Nav_Logs]}" TabIndex="4" />
            <Button Content="{Binding Localizer[Nav_Settings]}" Command="{Binding GoToSettingsCommand}"
                    AutomationProperties.Name="{Binding Localizer[Nav_Settings]}" TabIndex="5" />
        </StackPanel>

        <!-- Screens. Only one is visible at a time. -->
        <Grid Grid.Row="2">
            <views:ScanView DataContext="{Binding Scan}"
                            Visibility="{Binding DataContext.IsScan, RelativeSource={RelativeSource AncestorType=Window},
                                                 Converter={StaticResource BoolToVisibility}}" />

            <views:ReviewView DataContext="{Binding Review}"
                              Visibility="{Binding DataContext.IsReview, RelativeSource={RelativeSource AncestorType=Window},
                                                   Converter={StaticResource BoolToVisibility}}" />

            <views:ApplyView DataContext="{Binding Apply}"
                             Visibility="{Binding DataContext.IsApply, RelativeSource={RelativeSource AncestorType=Window},
                                                  Converter={StaticResource BoolToVisibility}}" />

            <views:ResultsView DataContext="{Binding Results}"
                               Visibility="{Binding DataContext.IsResults, RelativeSource={RelativeSource AncestorType=Window},
                                                    Converter={StaticResource BoolToVisibility}}" />

            <views:LogsView DataContext="{Binding Logs}"
                            Visibility="{Binding DataContext.IsLogs, RelativeSource={RelativeSource AncestorType=Window},
                                                 Converter={StaticResource BoolToVisibility}}" />

            <views:SettingsView DataContext="{Binding Settings}"
                                Visibility="{Binding DataContext.IsSettings, RelativeSource={RelativeSource AncestorType=Window},
                                                     Converter={StaticResource BoolToVisibility}}" />
        </Grid>
    </Grid>
</Window>
