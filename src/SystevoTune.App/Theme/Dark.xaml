<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Dark theme, doc 06 Phase 3. Deliberately plain: this session cannot run the app, so the
        styling stays to colours, spacing and font size. Anything needing visual judgement waits
        until it can be looked at.

        Accent and Focus are the two colours sampled out of the Systevo mark itself
        (Assets/systevo-logo.png) — #0070F3 and #22D3EE. A test asserts both hexes really are
        present in the logo's pixels, so the theme cannot drift away from the brand silently.

        Two different WCAG bars apply here, and which one depends on how a colour is used:

          Text colours need 4.5:1 (WCAG 1.4.3). Measured against Surface #1E1F24:
            Text 13.6:1  ·  Muted 5.9:1  ·  Success 8.4:1  ·  Warning 8.9:1  ·  Danger 5.1:1

          UI-component colours need 3:1 (WCAG 1.4.11). Accent is a border and a fill, never text:
            Accent        #0070F3 on Surface 3.61:1  ·  on Background 3.97:1
            Focus         #22D3EE on Surface 9.10:1
            ControlBorder #70737C on Surface 3.47:1  ·  on the button fill 3.02:1

        Where the brand blue sits *behind* text, the label decides the bar: white on #0070F3 is
        4.55:1 and clears it; the near-black previously used there was 4.11:1 and did not.
    -->

    <Color x:Key="BackgroundColor">#15161A</Color>
    <Color x:Key="SurfaceColor">#1E1F24</Color>
    <Color x:Key="SurfaceRaisedColor">#282A31</Color>
    <!--
        Two borders, because the two jobs have different bars.

        BorderColor draws card edges — a container boundary, which 1.4.11 counts as decoration
        and sets no contrast bar for. The text inside the card carries the meaning at 13.6:1.

        ControlBorderColor draws buttons, and that one is load-bearing: the raised button fill is
        only 1.15:1 different from the card behind it, so the border is the only thing marking a
        button as a button. Both adjacent colours therefore need 3:1. The old shared #3A3D46 gave
        1.52:1 on the card and 1.32:1 on the fill, so a button at rest was very nearly invisible;
        #70737C gives 3.47:1 and 3.02:1. Caught by a test written while aligning the accent —
        this environment cannot launch the app, so nobody had ever actually looked at it.
    -->
    <Color x:Key="BorderColor">#3A3D46</Color>
    <Color x:Key="ControlBorderColor">#70737C</Color>
    <Color x:Key="TextColor">#ECEDEF</Color>
    <Color x:Key="MutedColor">#9EA3AD</Color>

    <!-- Systevo brand blue, straight from the mark. -->
    <Color x:Key="AccentColor">#0070F3</Color>

    <!-- Systevo brand cyan. Keyboard focus, so it reads differently from a hover. -->
    <Color x:Key="FocusColor">#22D3EE</Color>

    <Color x:Key="SuccessColor">#5BD08A</Color>
    <Color x:Key="WarningColor">#E8C468</Color>
    <Color x:Key="DangerColor">#FF6B6B</Color>

    <SolidColorBrush x:Key="Background" Color="{StaticResource BackgroundColor}" />
    <SolidColorBrush x:Key="Surface" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceRaised" Color="{StaticResource SurfaceRaisedColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="ControlBorder" Color="{StaticResource ControlBorderColor}" />
    <SolidColorBrush x:Key="Text" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="Muted" Color="{StaticResource MutedColor}" />
    <SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="Focus" Color="{StaticResource FocusColor}" />
    <SolidColorBrush x:Key="Success" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="Warning" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="Danger" Color="{StaticResource DangerColor}" />

    <!--
        Segoe UI Historic and Tahoma carry Arabic well and ship with Windows. Doc 08 wants Arabic
        to be a first-class language rather than English with the glyphs swapped.
    -->
    <FontFamily x:Key="UiFont">Segoe UI, Tahoma, Arial</FontFamily>

    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="Heading" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,4" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="Subheading" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Muted}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Margin" Value="0,0,0,16" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="SectionHeading" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,12,0,6" />
    </Style>

    <Style x:Key="MutedText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Muted}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="DangerText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Danger}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="Background" Value="{StaticResource SurfaceRaised}" />
        <!-- ControlBorder, not BorderBrush: this outline is what makes a button look clickable. -->
        <Setter Property="BorderBrush" Value="{StaticResource ControlBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="14,7" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="MinWidth" Value="96" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Shell"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Shell" Property="BorderBrush" Value="{StaticResource Accent}" />
                        </Trigger>
                        <!--
                            Keyboard focus must be as visible as hover, or tabbing is guesswork —
                            and it uses the brand cyan rather than the blue so the two states are
                            told apart by colour, not only by border width.
                        -->
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Shell" Property="BorderBrush" Value="{StaticResource Focus}" />
                            <Setter TargetName="Shell" Property="BorderThickness" Value="2" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Shell" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        White label, not the near-black used elsewhere: on the brand blue, near-black measures
        4.11:1 and white 4.55:1. The 4.5:1 bar applies because this is text on a fill.
    -->
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource Accent}" />
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="BigUndoButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource Success}" />
        <Setter Property="Foreground" Value="#0B1220" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Padding" Value="22,14" />
        <Setter Property="MinWidth" Value="240" />
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Margin" Value="0,3" />
    </Style>

    <!--
        Foreground and Background are not optional here, and leaving them out is what made the
        language switcher look empty on the VM's first run. A ComboBox with no Background keeps
        WPF's default light chrome, while the implicit TextBlock style above paints every TextBlock
        #ECEDEF — so the selected item rendered near-white on near-white. The control was never
        empty; its text was invisible, and the language could not be changed.
    -->
    <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="Background" Value="{StaticResource SurfaceRaised}" />
        <Setter Property="BorderBrush" Value="{StaticResource ControlBorder}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="6,4" />
        <Setter Property="MinWidth" Value="150" />
    </Style>

    <!-- The dropdown's rows are separate controls and inherit none of the above. -->
    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="Background" Value="{StaticResource SurfaceRaised}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="6,4" />
    </Style>

    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="14" />
        <Setter Property="Margin" Value="0,0,0,10" />
    </Style>

</ResourceDictionary>
