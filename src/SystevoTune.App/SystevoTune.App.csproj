<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>SystevoTune.App</RootNamespace>
    <AssemblyName>SystevoTune</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\systevo.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Brand assets taken from systevo.vercel.app. Embedded rather than fetched: doc 01 says no
      cloud and no network, and a portable single-file build has to carry its own logo.
    -->
    <Resource Include="Assets\systevo-logo.png" />
    <!--
      The .ico needs to be BOTH. ApplicationIcon above sets the exe's Win32 icon, which is what
      Explorer and the taskbar read; it embeds nothing WPF can load. MainWindow.xaml also sets
      Icon="Assets/systevo.ico" for the title bar, and that needs a real WPF resource. Without
      this line the app built, published and passed CI, then died on every launch with
      "Cannot locate resource 'assets/systevo.ico'".
    -->
    <Resource Include="Assets\systevo.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SystevoTune.Engine\SystevoTune.Engine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Language packs ship inside the exe so a portable build is one file. -->
    <EmbeddedResource Include="Localization\Strings\*.json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SystevoTune.App.Tests" />
  </ItemGroup>

</Project>
