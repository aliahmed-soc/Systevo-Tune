<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>SystevoTune.ConsoleRunner</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SystevoTune.Engine\SystevoTune.Engine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The VM-flag interlock is a safety feature, so it is unit tested rather than run. -->
    <InternalsVisibleTo Include="SystevoTune.Engine.Tests" />
  </ItemGroup>

</Project>
