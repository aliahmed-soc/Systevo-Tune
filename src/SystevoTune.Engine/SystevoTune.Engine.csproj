<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>SystevoTune.Engine</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Tests assert on verified paths and command building without widening the public API. -->
    <InternalsVisibleTo Include="SystevoTune.Engine.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Whitelists ship inside the assembly so a user cannot redirect cleanup by dropping a file
      next to the exe. Editing the repo copy and rebuilding is the only way to change them.
    -->
    <EmbeddedResource Include="Whitelists\*.json" />
    <EmbeddedResource Include="Profiles\*.json" />
  </ItemGroup>

</Project>
