{
  "$comment": [
    "Every registry value the engine is allowed to write. Nothing here may be hard-coded in C#.",
    "UNVERIFIED: all of these came from model knowledge on 2026-07-26 and are listed in the",
    "windows-verified-paths skill as U17-U26. Check each against Microsoft docs before a VM run.",
    "Forbidden by project rule and never to be added here: anything under Defender, the firewall,",
    "network, audio, or printer services."
  ],
  "version": 1,
  "tweaks": [
    {
      "id": "visual-effects.performance",
      "nameEn": "Visual effects: best performance",
      "nameAr": "المؤثرات المرئية: أفضل أداء",
      "requiresRestart": false,
      "note": "Takes full effect after Explorer restarts or the user signs out.",
      "values": [
        {
          "root": "HKCU",
          "key": "Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\VisualEffects",
          "name": "VisualFXSetting",
          "type": "Dword",
          "data": "2"
        },
        {
          "root": "HKCU",
          "key": "Software\\Microsoft\\Windows\\CurrentVersion\\Themes\\Personalize",
          "name": "EnableTransparency",
          "type": "Dword",
          "data": "0"
        },
        {
          "root": "HKCU",
          "key": "Control Panel\\Desktop\\WindowMetrics",
          "name": "MinAnimate",
          "type": "String",
          "data": "0"
        }
      ]
    },
    {
      "id": "visual-effects.appearance",
      "nameEn": "Visual effects: best appearance",
      "nameAr": "المؤثرات المرئية: أفضل مظهر",
      "requiresRestart": false,
      "note": "The Work-profile counterpart. Undo still restores the user's own values, not these.",
      "values": [
        {
          "root": "HKCU",
          "key": "Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\VisualEffects",
          "name": "VisualFXSetting",
          "type": "Dword",
          "data": "1"
        },
        {
          "root": "HKCU",
          "key": "Software\\Microsoft\\Windows\\CurrentVersion\\Themes\\Personalize",
          "name": "EnableTransparency",
          "type": "Dword",
          "data": "1"
        },
        {
          "root": "HKCU",
          "key": "Control Panel\\Desktop\\WindowMetrics",
          "name": "MinAnimate",
          "type": "String",
          "data": "1"
        }
      ]
    },
    {
      "id": "game-mode.on",
      "nameEn": "Game Mode on",
      "nameAr": "وضع الألعاب مفعّل",
      "requiresRestart": false,
      "values": [
        {
          "root": "HKCU",
          "key": "Software\\Microsoft\\GameBar",
          "name": "AutoGameModeEnabled",
          "type": "Dword",
          "data": "1"
        }
      ]
    },
    {
      "id": "game-mode.off",
      "nameEn": "Game Mode off",
      "nameAr": "وضع الألعاب متوقف",
      "requiresRestart": false,
      "values": [
        {
          "root": "HKCU",
          "key": "Software\\Microsoft\\GameBar",
          "name": "AutoGameModeEnabled",
          "type": "Dword",
          "data": "0"
        }
      ]
    },
    {
      "id": "game-bar.background-recording-off",
      "nameEn": "Xbox Game Bar background recording off",
      "nameAr": "إيقاف التسجيل الخلفي لشريط الألعاب",
      "requiresRestart": false,
      "values": [
        {
          "root": "HKCU",
          "key": "System\\GameConfigStore",
          "name": "GameDVR_Enabled",
          "type": "Dword",
          "data": "0"
        },
        {
          "root": "HKLM",
          "key": "SOFTWARE\\Policies\\Microsoft\\Windows\\GameDVR",
          "name": "AllowGameDVR",
          "type": "Dword",
          "data": "0"
        }
      ]
    },
    {
      "id": "gpu-scheduling.on",
      "nameEn": "Hardware-accelerated GPU scheduling on",
      "nameAr": "جدولة وحدة معالجة الرسوميات المسرَّعة",
      "requiresRestart": true,
      "note": "Doc 3.6: needs a restart. Not supported on every GPU or driver; if the value is absent the tweak reports NotApplicable.",
      "requiresExistingValue": true,
      "values": [
        {
          "root": "HKLM",
          "key": "SYSTEM\\CurrentControlSet\\Control\\GraphicsDrivers",
          "name": "HwSchMode",
          "type": "Dword",
          "data": "2"
        }
      ]
    }
  ]
}
