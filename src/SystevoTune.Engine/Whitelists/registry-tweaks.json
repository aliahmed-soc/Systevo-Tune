{
  "$comment": [
    "Every registry value the engine is allowed to write. Nothing here may be hard-coded in C#.",
    "AllowGameDVR is VERIFIED against the ApplicationManagement Policy CSP. Everything else here",
    "is undocumented by Microsoft and community-sourced - see Tier 2 of the windows-verified-paths",
    "skill. Confirm each in the VM before trusting it.",
    "Forbidden by project rule and never to be added here: anything under Defender, the firewall,",
    "network, audio, or printer services."
  ],
  "version": 1,
  "tweaks": [
    {
      "id": "visual-effects.performance",
      "nameEn": "Visual effects: best performance",
      "nameAr": "المؤثرات المرئية: أفضل أداء",
      "requiresRestart": false,
      "note": "Takes full effect after Explorer restarts or the user signs out.",
      "values": [
        {
          "root": "HKCU",
          "key": "Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\VisualEffects",
          "name": "VisualFXSetting",
          "type": "Dword",
          "data": "2"
        },
        {
          "root": "HKCU",
          "key": "Software\\Microsoft\\Windows\\CurrentVersion\\Themes\\Personalize",
          "name": "EnableTransparency",
          "type": "Dword",
          "data": "0"
        },
        {
          "root": "HKCU",
          "key": "Control Panel\\Desktop\\WindowMetrics",
          "name": "MinAnimate",
          "type": "String",
          "data": "0"
        }
      ]
    },
    {
      "id": "visual-effects.appearance",
      "nameEn": "Visual effects: best appearance",
      "nameAr": "المؤثرات المرئية: أفضل مظهر",
      "requiresRestart": false,
      "note": "The Work-profile counterpart. Undo still restores the user's own values, not these.",
      "values": [
        {
          "root": "HKCU",
          "key": "Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\VisualEffects",
          "name": "VisualFXSetting",
          "type": "Dword",
          "data": "1"
        },
        {
          "root": "HKCU",
          "key": "Software\\Microsoft\\Windows\\CurrentVersion\\Themes\\Personalize",
          "name": "EnableTransparency",
          "type": "Dword",
          "data": "1"
        },
        {
          "root": "HKCU",
          "key": "Control Panel\\Desktop\\WindowMetrics",
          "name": "MinAnimate",
          "type": "String",
          "data": "1"
        }
      ]
    },
    {
      "id": "game-mode.on",
      "nameEn": "Game Mode on",
      "nameAr": "وضع الألعاب مفعّل",
      "requiresRestart": false,
      "values": [
        {
          "root": "HKCU",
          "key": "Software\\Microsoft\\GameBar",
          "name": "AutoGameModeEnabled",
          "type": "Dword",
          "data": "1"
        }
      ]
    },
    {
      "id": "game-mode.off",
      "nameEn": "Game Mode off",
      "nameAr": "وضع الألعاب متوقف",
      "requiresRestart": false,
      "values": [
        {
          "root": "HKCU",
          "key": "Software\\Microsoft\\GameBar",
          "name": "AutoGameModeEnabled",
          "type": "Dword",
          "data": "0"
        }
      ]
    },
    {
      "id": "game-bar.background-recording-off",
      "nameEn": "Xbox Game Bar recording off",
      "nameAr": "إيقاف تسجيل شريط الألعاب",
      "requiresRestart": false,
      "note": "Scope widened 2026-07-27 - see decision 30. HistoricalCaptureEnabled is the precise 'Record what happened' background-recording lever doc 3.6 asks for. AppCaptureEnabled is broader: it also stops the user recording a clip by hand, which is why the display name no longer says 'background'. Undo restores both.",
      "values": [
        {
          "root": "HKCU",
          "key": "System\\GameConfigStore",
          "name": "GameDVR_Enabled",
          "type": "Dword",
          "data": "0"
        },
        {
          "root": "HKCU",
          "key": "SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\GameDVR",
          "name": "HistoricalCaptureEnabled",
          "type": "Dword",
          "data": "0"
        },
        {
          "root": "HKCU",
          "key": "SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\GameDVR",
          "name": "AppCaptureEnabled",
          "type": "Dword",
          "data": "0"
        },
        {
          "root": "HKLM",
          "key": "SOFTWARE\\Policies\\Microsoft\\Windows\\GameDVR",
          "name": "AllowGameDVR",
          "type": "Dword",
          "data": "0"
        }
      ]
    },
    {
      "id": "privacy.telemetry-minimal",
      "nameEn": "Diagnostic data: required only",
      "nameAr": "بيانات التشخيص: الضروري فقط",
      "requiresRestart": false,
      "note": "VERIFIED against the System Policy CSP. Deliberately writes 1 (Basic/required), NOT 0. Microsoft states 0 is only honoured on Enterprise, Education and Server - on Home and Pro it behaves exactly like 1. Writing 0 and calling it 'telemetry off' would be a claim we cannot keep, which doc 01 rules out. The name says what actually happens. Decision 38.",
      "values": [
        {
          "root": "HKLM",
          "key": "SOFTWARE\\Policies\\Microsoft\\Windows\\DataCollection",
          "name": "AllowTelemetry",
          "type": "Dword",
          "data": "1"
        }
      ]
    },
    {
      "id": "privacy.start-menu-suggestions-off",
      "nameEn": "Start menu suggestions and app pushes off",
      "nameAr": "إيقاف اقتراحات قائمة ابدأ",
      "requiresRestart": false,
      "note": "UNVERIFIED - ContentDeliveryManager is undocumented by Microsoft. N18-N20 in the verified-paths skill. SilentInstalledAppsEnabled is the one that silently installs suggested apps.",
      "values": [
        {
          "root": "HKCU",
          "key": "Software\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager",
          "name": "SystemPaneSuggestionsEnabled",
          "type": "Dword",
          "data": "0"
        },
        {
          "root": "HKCU",
          "key": "Software\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager",
          "name": "SubscribedContent-338388Enabled",
          "type": "Dword",
          "data": "0"
        },
        {
          "root": "HKCU",
          "key": "Software\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager",
          "name": "SilentInstalledAppsEnabled",
          "type": "Dword",
          "data": "0"
        }
      ]
    },
    {
      "id": "privacy.tips-and-lock-screen-ads-off",
      "nameEn": "Windows tips and lock screen ads off",
      "nameAr": "إيقاف نصائح ويندوز وإعلانات شاشة القفل",
      "requiresRestart": false,
      "note": "UNVERIFIED - ContentDeliveryManager, N21-N23. Turns off the 'get to know Windows' tips and the lock screen Spotlight overlay text. Does NOT turn off the Spotlight wallpaper itself, which is a picture the user chose.",
      "values": [
        {
          "root": "HKCU",
          "key": "Software\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager",
          "name": "SoftLandingEnabled",
          "type": "Dword",
          "data": "0"
        },
        {
          "root": "HKCU",
          "key": "Software\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager",
          "name": "SubscribedContent-338389Enabled",
          "type": "Dword",
          "data": "0"
        },
        {
          "root": "HKCU",
          "key": "Software\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager",
          "name": "RotatingLockScreenOverlayEnabled",
          "type": "Dword",
          "data": "0"
        }
      ]
    },
    {
      "id": "gpu-scheduling.on",
      "nameEn": "Hardware-accelerated GPU scheduling on",
      "nameAr": "جدولة وحدة معالجة الرسوميات المسرَّعة",
      "requiresRestart": true,
      "note": "Doc 3.6: needs a restart. Not supported on every GPU or driver; if the value is absent the tweak reports NotApplicable.",
      "requiresExistingValue": true,
      "values": [
        {
          "root": "HKLM",
          "key": "SYSTEM\\CurrentControlSet\\Control\\GraphicsDrivers",
          "name": "HwSchMode",
          "type": "Dword",
          "data": "2"
        }
      ]
    }
  ]
}
